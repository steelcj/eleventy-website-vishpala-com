<?xml version="1.0" encoding="utf-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
{%- for p in collections.all %}
{%- if p.url and p.data.sitemap != false and p.url.endsWith("/") %}
  <url>
    <loc>{{ site.url }}{{ p.url }}</loc>
    <lastmod>{{ p.date.toISOString().slice(0, 10) }}</lastmod>
    {%- for tr in collections.all | translationsOf(p.data.translationKey, p.data.lang) %}
    <xhtml:link rel="alternate" hreflang="{{ tr.data.lang }}" href="{{ site.url }}{{ tr.url }}"/>
    {%- endfor %}
  </url>
{%- endif %}
{%- endfor %}
</urlset>
