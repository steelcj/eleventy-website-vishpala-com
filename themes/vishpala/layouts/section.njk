---
layout: layouts/base.njk
hero: true
mainClass: site-main--page
---
{%- set t = theme.strings[lang] or theme.strings.en -%}
{%- macro entryList(items, headingLevel) %}
<ul class="entry-list">
  {%- for e in items %}
  {%- set href = e.data.externalUrl or e.url %}
  <li>
    <h{{ headingLevel }} class="entry-title">
      <a href="{{ href }}"{% if e.data.externalUrl %} rel="noopener"{% endif %}>{{ e.data.heading or e.data.title }}</a>
      {%- if e.data.externalUrl %} <span class="entry-external">({{ t.externalSite }})</span>{% endif %}
    </h{{ headingLevel }}>
    {%- if e.data.description %}
    <p class="entry-description">{{ e.data.description }}</p>
    {%- endif %}
  </li>
  {%- endfor %}
</ul>
{%- endmacro %}
<div class="page-content">
  {{ content | safe }}
</div>

{#- metricResults: this site's web-metrics results, for every quality ("all") or for one -#}
{%- if metricResults and site.metrics %}
{%- set testedUrl = site.url + (site.metrics.tested or "/") %}
<section class="metric-results" aria-labelledby="metric-results-title">
  <h2 id="metric-results-title">{{ t.metricsTitle }}</h2>
  <p>{{ t.metricsIntro }}</p>
  <ul class="metric-list">
    {%- for q in theme.qualities %}
    {%- set results = site.metrics.results | metricResults(q) %}
    {%- if results.length and (metricResults == "all" or metricResults == q) %}
    <li id="metric-{{ q }}">
      <svg class="kamon kamon-{{ q }}" width="64" height="64" aria-hidden="true" focusable="false"><use href="/theme/img/kamon.svg#kamon-{{ q }}"></use></svg>
      <div>
        <h3>{{ t.qualities[q] }}</h3>
        {%- for r in results %}
        {%- set tool = theme.metricTools[r.tool] %}
        <p><strong>{{ tool.name if tool else t.metricsSelfAssessed }}</strong>{{ t.comma }} {{ t.metricsTested }} <time datetime="{{ r.tested }}" dir="ltr">{{ r.tested }}</time>{{ t.colon }} {{ r.result | inLang(lang) }}.
          {%- if tool %} <a href="{{ r.tool | metricTestUrl(testedUrl) }}">{{ t.metricsTestYourself | replace("{tool}", tool.runner or tool.name) }}</a>{% endif %}</p>
        {%- endfor %}
      </div>
    </li>
    {%- endif %}
    {%- endfor %}
  </ul>
</section>
{%- endif %}

{#- listCategory: list the resource entries in this folder (set by the folder's data file) -#}
{%- if listCategory %}
{%- set entries = collections.all | byLang(lang) | whereData("resourceEntry", true) | whereData("category", listCategory) | sort(false, false, "data.order") %}
{%- if entries.length %}{{ entryList(entries, 2) }}{% endif %}
{%- endif %}

{#- listTag: list the pages carrying a tag, optionally grouped by listCategories -#}
{%- if listTag and collections[listTag] %}
{%- set entries = collections[listTag] | byLang(lang) | sort(false, false, "data.order") %}
{%- if listCategories and listCategories.length %}
{%- for cat in listCategories %}
{%- set group = [] %}
{%- for e in entries %}{% if e.data.category == cat.key %}{% set group = (group.push(e), group) %}{% endif %}{% endfor %}
{%- if group.length %}
<section class="entry-group" aria-labelledby="group-{{ cat.key }}">
  <h2 id="group-{{ cat.key }}" class="entry-group-title">{{ cat.title }}</h2>
  {%- if cat.text %}<p class="entry-group-text">{{ cat.text }}</p>{% endif %}
  {{ entryList(group, 3) }}
</section>
{%- endif %}
{%- endfor %}
{%- elif entries.length %}
{{ entryList(entries, 2) }}
{%- endif %}
{%- endif %}

{%- if related and related.length %}
<aside class="page-related" data-pagefind-ignore aria-labelledby="related-heading">
  <h2 id="related-heading">{{ t.related }}</h2>
  <ul>
    {%- for r in related %}
    <li><a href="{{ r.url }}">{{ r.text }}</a></li>
    {%- endfor %}
  </ul>
</aside>
{%- endif %}
